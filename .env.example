# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Optional Real Broker Execution Bridges (set in .env)
# Configure a provider below to route live/practice orders server-side.
# BROKER_PROVIDER picks which one runs: OANDA | METAAPI | CTRADER | MT5 | WEBHOOK | SIMULATION.
# Left empty, the first configured one wins (OANDA, METAAPI, CTRADER, MT5, WEBHOOK).
# ------------------------------------------------------------------
BROKER_PROVIDER=""

# 1) OANDA v20 REST API (Spot Gold XAU_USD & FX CFDs)
OANDA_API_TOKEN=""
OANDA_ACCOUNT_ID=""
OANDA_ENV="practice"

# 2) MetaApi Cloud (Connects any MT4 / MT5 broker account)
METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""
METAAPI_SYMBOL_XAU="XAUUSD"

# 3) cTrader Open API (register app at https://openapi.ctrader.com)
# Redirect URL registered there must match CTRADER_REDIRECT_URI exactly.
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI="http://localhost:3000/api/ctrader/callback"
CTRADER_ENV="demo"               # demo | live
CTRADER_ACCESS_TOKEN=""          # optional: paste token from Playground
CTRADER_REFRESH_TOKEN=""
CTRADER_ACCOUNT_ID=""            # ctidTraderAccountId
CTRADER_SYMBOL_XAU="XAUUSD"

# 4) Local MT5 bridge, no MetaApi needed (e.g. Blue Guardian / any MT5 prop account)
# Runs bridge/mt5_bridge.py next to a logged-in MT5 terminal on this PC:
#   pip install MetaTrader5
#   python bridge/mt5_bridge.py      (reads MT5_BRIDGE_SECRET from this .env)
MT5_BRIDGE_URL="http://127.0.0.1:8765"
MT5_BRIDGE_SECRET=""             # at least 16 random characters
MT5_SYMBOL_XAU="XAUUSD"          # exact symbol name in the terminal (some firms add a suffix)

# 5) Custom Broker Webhook Bridge (e.g. local MT5 Python EA / cTrader)
BROKER_WEBHOOK_URL=""
BROKER_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Local server
# ------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1          # 0.0.0.0 = reachable from other devices on your LAN
# ALLOWED_HOSTS=192.168.1.20  # extra hostnames/IPs the API answers to (needed with HOST=0.0.0.0)
# KESTREL_DATA_DIR=./data # bot state + audit log

# Hard risk limits for real-broker orders (Blue Guardian 5k: daily loss $150, max loss $250).
# They cap the bot's own settings; the bot can ask for more but never gets more.
LIVE_MAX_LOT="0.05"               # biggest lot per order
LIVE_MAX_RISK_PER_TRADE="25"      # max $ lost if one trade hits its stop-loss (cuts the lot to fit)
LIVE_DAILY_LOSS_LIMIT="100"       # stop opening trades when today's worst case reaches this ($150 firm limit)
LIVE_MIN_EQUITY="4800"            # never risk equity down to this level ($4,750 firm breach level)
LIVE_MAX_POSITIONS="2"            # open trades at once
