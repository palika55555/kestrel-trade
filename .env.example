# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Optional Real Broker Execution Bridges (set in .env)
# Configure ONE provider below to route live/practice orders server-side.
# ------------------------------------------------------------------

# 1) OANDA v20 REST API (Spot Gold XAU_USD & FX CFDs)
OANDA_API_TOKEN=""
OANDA_ACCOUNT_ID=""
OANDA_ENV="practice"

# 2) MetaApi Cloud (Connects any MT4 / MT5 broker account)
METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""
METAAPI_SYMBOL_XAU="XAUUSD"

# 3) cTrader Open API (register app at https://openapi.ctrader.com)
# Redirect URL registered there must match CTRADER_REDIRECT_URI exactly.
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI="http://localhost:3000/api/ctrader/callback"
CTRADER_ENV="demo"               # demo | live
CTRADER_ACCESS_TOKEN=""          # optional: paste token from Playground
CTRADER_REFRESH_TOKEN=""
CTRADER_ACCOUNT_ID=""            # ctidTraderAccountId
CTRADER_SYMBOL_XAU="XAUUSD"

# 4) Custom Broker Webhook Bridge (e.g. local MT5 Python EA / cTrader)
BROKER_WEBHOOK_URL=""
BROKER_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Local server
# ------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1          # 0.0.0.0 = reachable from other devices on your LAN
# ALLOWED_HOSTS=192.168.1.20  # extra hostnames/IPs the API answers to (needed with HOST=0.0.0.0)
# KESTREL_DATA_DIR=./data # bot state + audit log
